{
  "name": "taskmanagerwebdav",
  "private": true,
  "version": "1.0.0",
  "author": {
    "name": "Johan van Soest",
    "email": "info@johanvansoest.nl"
  },
  "main": "electron/main.mjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/generate-sw.mjs",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "start": "node proxy/server.mjs",
    "proxy": "node proxy/server.mjs",
    "proxy:test-auth": "node proxy/test-auth.mjs",
    "migrate:task-ids": "node scripts/migrate-task-ids-to-collection-scope.mjs",
    "desktop:dev": "npm run build && electron .",
    "desktop:dist": "npm run build && electron-builder --publish never",
    "desktop:dist:mac": "npm run build && electron-builder --mac --universal --publish never",
    "desktop:dist:win": "npm run build && electron-builder --win --x64 --publish never",
    "desktop:dist:linux": "npm run build && electron-builder --linux --x64 --publish never",
    "desktop:dist:dir": "npm run build && electron-builder --dir",
    "android:build:web": "tsc -b && vite build --mode android && node scripts/generate-sw.mjs",
    "android:sync": "npm run android:build:web && cap sync android",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "android:bundle": "npm run android:sync && cd android && ./gradlew bundleRelease",
    "android:open": "cap open android",
    "ios:build:web": "tsc -b && vite build --mode ios && node scripts/generate-sw.mjs",
    "ios:sync": "npm run ios:build:web && cap sync ios",
    "ios:build": "npm run ios:sync && xcodebuild -project ios/App/App.xcodeproj -scheme App -configuration Debug -destination 'generic/platform=iOS' -derivedDataPath ios/DerivedData CODE_SIGNING_ALLOWED=NO build",
    "ios:archive": "npm run ios:sync && xcodebuild -project ios/App/App.xcodeproj -scheme App -configuration Release -destination 'generic/platform=iOS' -archivePath ios/build/TaskManagerWebDav.xcarchive archive",
    "ios:open": "cap open ios"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.0",
    "@capacitor/local-notifications": "^8.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@electron/notarize": "^3.1.0",
    "@types/node": "^25.5.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.15.0",
    "@typescript-eslint/parser": "^7.15.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^35.1.5",
    "electron-builder": "^26.0.12",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.7",
    "typescript": "^5.2.2",
    "vite": "^5.3.4"
  },
  "build": {
    "appId": "co.taskmanagerwebdav.app",
    "productName": "TaskManagerWebDav",
    "icon": "build/icon.png",
    "directories": {
      "output": "desktop-dist"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "proxy/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "asar": true,
    "afterSign": "electron/notarize.mjs",
    "mac": {
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "electron/entitlements.mac.plist",
      "entitlementsInherit": "electron/entitlements.mac.plist",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
